mapping query_questdg() {
  int i;
  mapping the_quest, random_quest;
  string *quest_key;

  random_quest = quest[random(sizeof(quest))];
  the_quest = ([]);

  quest_key = keys(random_quest);
  for (i = 0; i < sizeof(quest_key); i++)
    the_quest[quest_key[i]] = random_quest[quest_key[i]];

  return the_quest;
}
