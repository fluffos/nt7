// 初始化模板
void create() {
  setup();
}

// 在这里配置是否使用全格式模式或格式对应模式
void setup() {
  // 即基准文件为 "/inherit/template/gem/gem.lpc"。
  set_base_file("gem/gem");

  // 设置 dbase 格式
  set_dbase_format(dbase_format);

  // 设置模板数据
  set_template_data(template_data);

  ::setup();
}
